---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SceneRail from "../components/SceneRail.astro";
import JourneyOpening from "../components/JourneyOpening.astro";
import BlueprintScene from "../components/BlueprintScene.astro";
import WorkScene from "../components/WorkScene.astro";
import SubjectsScene from "../components/SubjectsScene.astro";
import HumanScene from "../components/HumanScene.astro";
import FormatsScene from "../components/FormatsScene.astro";
import JourneyFinal from "../components/JourneyFinal.astro";
import Icon from "../components/Icon.astro";
import "../styles/journey.css";
import "../styles/blueprint.css";
import "../styles/scenes.css";
import "../styles/extras.css";
import "../styles/loop-map.css";
import "../styles/polish.css";
import "../styles/boot.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Hopes and Dreams — образовательная среда"
  description="Физика, математика и информатика в связанной образовательной среде. Подготовка к ОГЭ и ЕГЭ с Сергеем."
>
  <canvas class="stage-canvas" data-stage-canvas data-base={base} aria-hidden="true"></canvas>
  <noscript>
    <img class="stage-canvas" src={`${base}/seq/approach/960/0001.webp`} alt="" />
  </noscript>
  <div class="stage-shade" aria-hidden="true"></div>
  <!-- the first frames arriving: the hero, still in the dark. Shown only when loading takes noticeable time. -->
  <div class="boot" data-boot hidden>
    <div class="boot__bar">
      <p class="boot__name">Hopes and Dreams</p>
      <button class="boot__skip" type="button" data-boot-skip hidden>Продолжить</button>
      <span class="boot__value" data-boot-value aria-hidden="true">000%</span>
      <span
        class="boot__line"
        role="progressbar"
        aria-label="Загрузка первой сцены"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-boot-line
      ><i></i></span>
    </div>
  </div>
  <SiteHeader />
  <SceneRail />
  <main class="journey">
    <JourneyOpening />
    <BlueprintScene />
    <WorkScene />
    <SubjectsScene />
    <HumanScene />
    <FormatsScene />
    <JourneyFinal />
  </main>
  <dialog class="lightbox" data-lightbox aria-label="Увеличенное изображение">
    <form method="dialog"><button class="lightbox__close" aria-label="Закрыть"><Icon name="close" /></button></form>
    <img data-lightbox-img alt="" />
  </dialog>
  <script>
    import "../scripts/journey";
  </script>
</BaseLayout>
