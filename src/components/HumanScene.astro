---
import { author } from "../data/content";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!-- Scene 05: the camera flies into the study pod, Saturn in its window (drawn live, see webgl/study.ts).
     First the work — now the person. -->
<section class="track track--still track--human" id="author" data-track="human" data-still data-scene-index="4">
  <div class="track__stage still" data-still-stage>
    <div class="still__shade still__shade--sides" aria-hidden="true"></div>

    <p class="human__intro" data-human-intro>Сначала — работа.<br />Теперь — человек.</p>

    <div class="still__content human" data-still-content>
      <div class="human__left">
        <p class="eyebrow"><span>05 / 07</span>Наблюдательный модуль</p>
        <div class="human__photos">
          {author.photos.map((p) => (
            <button type="button" class="photo-slot" data-zoom={`${base}/${p.src}`} aria-label={`Увеличить: ${p.alt}`}>
              <img src={`${base}/${p.src}`} alt={p.alt} loading="lazy" decoding="async" style={`object-position: ${p.pos}`} />
            </button>
          ))}
        </div>
        <h2 class="headline human__name">{author.name}</h2>
        <p class="human__role">{author.role}</p>
        {author.bio.map((p) => <p class="human__bio">{p}</p>)}
        <ul class="human__facts">
          {author.facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <div class="human__right">
        {author.diplomas.map((d) => (
          <button type="button" class="diploma" data-zoom={`${base}/${d.src}`} aria-label={`Увеличить: ${d.title}`}>
            <img src={`${base}/${d.src}`} alt={d.title} loading="lazy" />
            <span><b>{d.title}</b>{d.note}</span>
          </button>
        ))}
      </div>

      <div class="human__papers">
        <p class="human__papers-title">Статьи и научные публикации</p>
        <ul>
          {author.publications.map((p) => (
            <li>
              {p.href ? <a href={p.href} target="_blank" rel="noreferrer" lang="en">{p.title}</a> : <span lang="en">{p.title}</span>}
              <p class="human__paper-topic">{p.topic}</p>
              <small lang="en">{p.venue}</small>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
