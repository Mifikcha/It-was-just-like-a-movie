---
import Icon from "./Icon.astro";
import { links, quotes, subjects } from "../data/content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!-- Scenes 01–02: hero hold → camera travel to Sector B → HTML video on the display module. -->
<section class="track track--opening" id="top" data-track="approach" data-scene-index="0">
  <div class="track__stage">
    <div class="hero-ui" data-hero-ui>
      <div class="hero-ui__copy">
        <p class="eyebrow"><span>01 / 10</span>Завтра больше, чем сегодня</p>
        <h1 class="display">Возможность<br />нужно построить.</h1>
        <p class="lead">
          Hopes and Dreams — образовательная среда, где подготовка к экзамену становится
          системой связанных знаний, практики и решений.
        </p>
        <div class="cta-row">
          <a class="cta cta--primary" href="#approach">
            Посмотреть систему
            <svg viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" /></svg>
          </a>
          <a class="cta cta--quiet" href={links.telegram} target="_blank" rel="noreferrer">Обсудить обучение</a>
        </div>
        <ul class="subject-row" aria-label="Предметы">
          {subjects.map((subject) => <li>{subject}</li>)}
        </ul>
      </div>


      <p class="hero-ui__motto" aria-hidden="true">Знания<br />собирают<br />будущее</p>

      <figure class="hero-ui__quote" lang="en">
        <blockquote>{quotes.possibility.text}</blockquote>
        <figcaption>— {quotes.possibility.author}</figcaption>
        <p class="quote-ru" lang="ru">{quotes.possibility.ru}</p>
      </figure>
    </div>

    <div class="display-module" id="approach" data-display-module aria-labelledby="display-title">
      <div class="display-module__screen" data-video-screen data-quad="0.2995,0.3148 0.6849,0.3074 0.6979,0.6620 0.3010,0.6944">
        <!-- Live interface of the environment. When the film exists, swap the <img> for
             <video playsinline muted loop autoplay> with the same class. -->
        <a class="screen-live" href={links.hnd} target="_blank" rel="noreferrer" aria-label="Открыть демо Hopes and Dreams">
          <img src={`${base}/assets/hnd-interface.webp`} alt="Главная страница среды Hopes and Dreams: программы обучения и граф знаний" />
          <span class="screen-live__tag">Демо · открыть <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 14 14 4M6 4h8v8" /></svg></span>
        </a>
      </div>
      <div class="display-module__caption">
        <p class="eyebrow"><span>02 / 10</span>Сектор Б · экранный модуль</p>
        <h2 class="headline" id="display-title">Среда, а&nbsp;не набор уроков.</h2>
        <p>
          Программы, граф знаний, интерактивные инструменты и поддержка между занятиями
          работают как одна система.
        </p>
        <a class="text-link" href={links.hnd} target="_blank" rel="noreferrer">Открыть демо Hopes and Dreams <Icon name="arrow-ne" /></a>
      </div>
    </div>
  </div>
</section>
