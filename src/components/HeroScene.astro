---
import DysonSphere from "./DysonSphere.astro";
import { links, quotes } from "../data/content";
---

<section class="hero scene" id="top" data-scene="hero">
  <div class="starfield" aria-hidden="true"></div>
  <div class="hero__coordinate" aria-hidden="true">56.8389° N · 60.6057° E · SYSTEM ONLINE</div>
  <div class="hero__sphere-wrap" data-hero-visual>
    <DysonSphere />
  </div>

  <div class="hero__content page-grid">
    <div class="hero__statement" data-hero-copy>
      <h1>Возможность<br />нужно построить.</h1>
      <p class="hero__lead">
        Hopes and Dreams — образовательная среда, где подготовка к экзамену становится
        системой связанных знаний, практики и решений.
      </p>
      <div class="hero__actions">
        <a class="action action--primary" href="#system">Посмотреть систему</a>
        <a class="action action--quiet" href={links.telegram} target="_blank" rel="noreferrer">Обсудить обучение</a>
      </div>
      <p class="hero__context">Физика · Математика · Информатика</p>
    </div>

    <figure class="quote quote--hero" data-hero-quote>
      <blockquote>“{quotes.possibility.text}”</blockquote>
      <figcaption>— {quotes.possibility.author}</figcaption>
    </figure>
  </div>

  <a class="hero__scroll" href="#proof">
    <span>Начать движение</span>
    <svg viewBox="0 0 24 42" aria-hidden="true"><path d="M12 1v36M5 30l7 7 7-7" /></svg>
  </a>
</section>

<section class="film-window" aria-label="Место для будущего видео о Hopes and Dreams">
  <div class="film-window__track" aria-hidden="true"></div>
  <div class="film-window__frame">
    <div class="film-window__mark">
      <span>VIDEO MATERIAL REQUIRED</span>
      <small>Будущий ролик: среда, задачи, интерфейс и процесс работы</small>
    </div>
    <svg viewBox="0 0 82 82" aria-hidden="true"><circle cx="41" cy="41" r="39" /><path d="m34 28 22 13-22 13Z" /></svg>
  </div>
</section>
