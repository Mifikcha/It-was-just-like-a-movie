---
interface Props {
  variant?: "hero" | "final";
}
const { variant = "hero" } = Astro.props;
---

<div class:list={["dyson", `dyson--${variant}`]} data-dyson={variant} aria-hidden="true">
  <svg viewBox="0 0 800 800" role="presentation">
    <defs>
      <radialGradient id={`core-${variant}`} cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#ffffff" />
        <stop offset="0.2" stop-color="#d7ddff" />
        <stop offset="0.56" stop-color="#7dcfff" stop-opacity=".38" />
        <stop offset="1" stop-color="#7dcfff" stop-opacity="0" />
      </radialGradient>
      <filter id={`soft-${variant}`} x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="12" />
      </filter>
    </defs>

    <g class="dyson__measure">
      <circle cx="400" cy="400" r="318" />
      <circle cx="400" cy="400" r="286" stroke-dasharray="2 13" />
      <path d="M79 400H721M400 79V721" />
      <path d="M173 173L627 627M627 173L173 627" opacity=".25" />
    </g>

    <g class="dyson__orbits">
      <ellipse cx="400" cy="400" rx="332" ry="116" transform="rotate(-14 400 400)" />
      <ellipse cx="400" cy="400" rx="326" ry="148" transform="rotate(31 400 400)" />
      <ellipse cx="400" cy="400" rx="178" ry="336" transform="rotate(17 400 400)" />
    </g>

    <g class="dyson__shell">
      <circle cx="400" cy="400" r="236" stroke-dasharray="96 18 38 14 124 22 58 26" />
      <ellipse cx="400" cy="400" rx="236" ry="82" />
      <ellipse cx="400" cy="400" rx="236" ry="82" transform="rotate(60 400 400)" />
      <ellipse cx="400" cy="400" rx="236" ry="82" transform="rotate(120 400 400)" />
      <ellipse cx="400" cy="400" rx="105" ry="236" transform="rotate(-18 400 400)" />
    </g>

    <g class="dyson__collectors">
      {Array.from({ length: 28 }, (_, index) => {
        const angle = (index / 28) * Math.PI * 2;
        const radius = index % 2 ? 236 : 274;
        const x = 400 + Math.cos(angle) * radius;
        const y = 400 + Math.sin(angle) * radius;
        return <rect x={x - 7} y={y - 3} width="14" height="6" rx="1" transform={`rotate(${(angle * 180) / Math.PI + 90} ${x} ${y})`} />;
      })}
    </g>

    <g class="dyson__nodes">
      <circle cx="84" cy="421" r="6" /><circle cx="236" cy="131" r="5" />
      <circle cx="648" cy="205" r="6" /><circle cx="696" cy="516" r="4" />
      <circle cx="470" cy="721" r="5" /><circle cx="176" cy="612" r="4" />
    </g>

    <circle class="dyson__halo" cx="400" cy="400" r="116" fill={`url(#core-${variant})`} filter={`url(#soft-${variant})`} />
    <circle class="dyson__core" cx="400" cy="400" r="48" fill={`url(#core-${variant})`} />
    <g class="dyson__crosshair">
      <path d="M400 324V354M400 446V476M324 400H354M446 400H476" />
      <circle cx="400" cy="400" r="64" />
    </g>
  </svg>
  <span class="dyson__label dyson__label--a">H&amp;D / DS-01</span>
  <span class="dyson__label dyson__label--b">φ = 1.618033</span>
  <span class="dyson__label dyson__label--c">structure / {variant === "final" ? "coherent" : "incomplete"}</span>
</div>
