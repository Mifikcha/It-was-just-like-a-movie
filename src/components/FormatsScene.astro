---
import { formats, links } from "../data/content";
---

<!-- Scene 09: formats as degrees of support. Calm grazing view along the finished sector. -->
<section class="track track--still" id="formats" data-track="formats" data-still data-scene-index="8">
  <div class="track__stage still" data-still-stage>
    <div class="still__shade still__shade--right" aria-hidden="true"></div>

    <div class="still__content formats" data-still-content>
      <header class="formats__head">
        <p class="eyebrow"><span>09 / 10</span>Форматы</p>
        <h2 class="headline">Формат — это степень<br />сопровождения.</h2>
        <p class="formats__lead">
          Не уровень доступа к материалам. Форматы различаются тем, насколько плотно преподаватель
          ведёт подготовку: от навигации раз в две недели до полностью индивидуального маршрута.
        </p>
      </header>
      <p class="platform-note">
        <span class="node-mark" aria-hidden="true"></span>
        <b>Доступ к платформе Hopes and Dreams — на каждом уровне.</b>
        Программы, материалы и инструменты среды доступны в любом формате — уровни отличаются только участием преподавателя.
      </p>
      <ol class="formats__list">
        {formats.map((f) => (
          <li class="format" data-format>
            <p class="format__level">Уровень {f.level}</p>
            <h3>{f.title}</h3>
            <p class="format__price">{f.price} <small class:list={{ "is-month": f.unit === "в месяц" }}>{f.unit}</small></p>
            {f.fine && <p class="format__fine">{f.fine}</p>}
            <ul>
              {f.includes.map((x) => <li>{x}</li>)}
            </ul>
            <p class="format__note">{f.note}</p>
          </li>
        ))}
      </ol>
      <a class="cta cta--primary" href={links.telegram} target="_blank" rel="noreferrer">
        Подобрать формат
        <svg viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" /></svg>
      </a>
    </div>
  </div>
</section>
