---
import { journey, links } from "../data/content";

// every scene between the opening and the contact screen, in scroll order
const sections = journey.slice(1, -1);
---

<header class="site-header" data-site-header>
  <a class="wordmark" href="#top" aria-label="Hopes and Dreams — к началу страницы">
    <span>Hopes</span><i>and</i><span>Dreams</span>
  </a>
  <nav aria-label="Разделы">
    {sections.map((s) => (
      <a href={`#${s.id}`} data-nav-scene={journey.indexOf(s)}>{s.title}</a>
    ))}
  </nav>
  <a class="header-contact" href={links.telegram} target="_blank" rel="noreferrer">
    Связаться
    <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 14 14 4M6 4h8v8" /></svg>
  </a>
</header>
