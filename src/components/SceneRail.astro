---
import { journey } from "../data/content";
---

<nav class="scene-rail" aria-label="Сцены" data-scene-rail>
  <ol>
    {journey.map((scene, i) => (
      <li data-rail-dot={i}>
        <a href={`#${scene.id}`}>
          <span class="scene-rail__label">{scene.title}</span>
          <i aria-hidden="true"></i>
        </a>
      </li>
    ))}
  </ol>
</nav>
