---
import KnowledgeGraph from "./KnowledgeGraph.astro";
import { links } from "../data/content";
const base = import.meta.env.BASE_URL;
---

<section class="system scene" id="system" data-scene="system">
  <div class="system__heading page-grid">
    <h2>Между занятиями<br />работа не исчезает.</h2>
    <div>
      <p>
        Hopes and Dreams связывает теорию, задачи, программы и инструменты в одной среде.
        Ученик видит не папку файлов, а карту следующего действия.
      </p>
      <a class="text-link" href={links.hnd} target="_blank" rel="noreferrer">
        Открыть Hopes and Dreams
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg>
      </a>
    </div>
  </div>

  <div class="system-observatory page-grid" data-system-observatory>
    <div class="system-observatory__graph">
      <KnowledgeGraph />
    </div>
    <div class="system-observatory__interface">
      <div class="interface-frame">
        <div class="interface-frame__chrome">
          <span>H&amp;D / public environment</span>
          <span class="interface-frame__signal">LIVE REFERENCE</span>
        </div>
        <div class="interface-frame__viewport">
          <img src={`${base}/assets/hnd-interface.webp`} alt="Главная страница действующей образовательной среды Hopes and Dreams" loading="lazy" width="1366" height="2334" />
        </div>
      </div>
    </div>
    <div class="system-observatory__formula" aria-label="Второй закон Ньютона: сила равна произведению массы на ускорение">
      <span>F = ma</span>
      <small>concept → model → problem → feedback</small>
    </div>
  </div>

  <div class="program-samples page-grid">
    <figure>
      <img src={`${base}/assets/program-physics.webp`} alt="Иллюстрация программы углублённой подготовки по физике" loading="lazy" width="1000" height="360" />
      <figcaption><span>Физика</span><small>структура программы / реальный asset</small></figcaption>
    </figure>
    <figure>
      <img src={`${base}/assets/program-code.webp`} alt="Иллюстрация программы подготовки по информатике" loading="lazy" width="1000" height="360" />
      <figcaption><span>Информатика</span><small>структура программы / реальный asset</small></figcaption>
    </figure>
  </div>
</section>
