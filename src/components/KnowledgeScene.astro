---
import { physicsMap, physicsLinks, routeWalked, routeAhead, programmeStrip, routePassport as pass } from "../data/content";

// The physics map of Hopes and Dreams as it is: every theory note is a star, every wikilink a line.
// One student's trajectory surfaces inside it; only the points that matter right now are named.
const byId = Object.fromEntries(physicsMap.map((n) => [n.id, n]));
type P = { x: number; y: number };

// a smooth line through the points (Catmull-Rom as cubic Béziers), so the route reads as a path, not a polyline
const smooth = (ps: P[]) =>
  ps.slice(1).reduce((d, p, i) => {
    const p0 = ps[i - 1] ?? ps[i];
    const p1 = ps[i];
    const p3 = ps[i + 2] ?? p;
    const c1 = `${(p1.x + (p.x - p0.x) / 6).toFixed(1)},${(p1.y + (p.y - p0.y) / 6).toFixed(1)}`;
    const c2 = `${(p.x - (p3.x - p1.x) / 6).toFixed(1)},${(p.y - (p3.y - p1.y) / 6).toFixed(1)}`;
    return `${d} C${c1} ${c2} ${p.x},${p.y}`;
  }, `M${ps[0].x},${ps[0].y}`);

const walkedD = smooth(routeWalked.map((id) => byId[id]));
const aheadD = smooth(routeAhead.map((id) => byId[id]));
const from = byId[routeWalked[0]];
const current = physicsMap.find((n) => n.state === "current")!;
const returned = physicsMap.find((n) => n.state === "returned")!;

// links inside the route light up with it; the rest of the map stays a quiet constellation
const onRoute = new Set([...routeWalked.slice(1), ...routeAhead]);
const links = physicsLinks.map(([a, b]) => ({ a: byId[a], b: byId[b], lit: onRoute.has(a) && onRoute.has(b) }));

// three lesson arcs around the current topic: estimated_lessons = 3, the second one is in progress
const lessonArc = (i: number, r = 15) => {
  const a0 = -Math.PI / 2 + (i * 2 * Math.PI) / 3 + 0.22;
  const a1 = a0 + (2 * Math.PI) / 3 - 0.44;
  const pt = (a: number) => `${(current.x + Math.cos(a) * r).toFixed(1)},${(current.y + Math.sin(a) * r).toFixed(1)}`;
  return `M${pt(a0)} A${r},${r} 0 0 1 ${pt(a1)}`;
};

const label = (n: (typeof physicsMap)[number]) => {
  const o = { s: [0, 46, "middle"], n: [0, -26, "middle"], e: [22, 7, "start"], w: [-20, -18, "end"], l: [-22, 7, "end"], dim: [0, 34, "middle"] }[n.label!];
  return { x: n.x + (o[0] as number), y: n.y + (o[1] as number), anchor: o[2] as string };
};
const named = physicsMap.filter((n) => n.label);

const counts = programmeStrip.flatMap((m) => m.states).reduce<Record<string, number>>((c, s) => ((c[s] = (c[s] ?? 0) + 1), c), {});
const total = programmeStrip.reduce((t, m) => t + m.states.length, 0);
---

<!-- Scene 06: the real physics map of Hopes and Dreams; one student's route through it. -->
<section class="track track--still" id="knowledge" data-track="knowledge" data-still data-scene-index="5">
  <div class="track__stage still" data-still-stage>
    <div class="still__shade still__shade--light" aria-hidden="true"></div>

    <svg class="kmap" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-kmap>
      <defs>
        <linearGradient id="kmap-walked" gradientUnits="userSpaceOnUse" x1={from.x} y1={from.y} x2={current.x} y2={current.y}>
          <stop offset="0" stop-color="#c9d6f0" stop-opacity="0" />
          <stop offset="0.18" stop-color="#c9d6f0" stop-opacity="0.38" />
          <stop offset="1" stop-color="#e3ecfa" stop-opacity="0.7" />
        </linearGradient>
      </defs>

      <g class="kmap__sky">
        {links.filter((l) => !l.lit).map(({ a, b }) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />)}
      </g>
      <g class="kmap__links">
        {links.filter((l) => l.lit).map(({ a, b }) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />)}
      </g>

      <path class="kmap__walked" d={walkedD} pathLength="1" stroke="url(#kmap-walked)" />
      <path class="kmap__ahead" d={aheadD} />

      <g class="kmap__nodes">
        {physicsMap.map((n) => (
          <circle
            class:list={["kmap__node", `is-${n.state}`, onRoute.has(n.id) && "is-route"]}
            cx={n.x}
            cy={n.y}
            r={n.state === "current" ? 5.5 : n.state === "todo" ? 2.6 : onRoute.has(n.id) ? 3.6 : 2.6}
          />
        ))}
      </g>

      <g class="kmap__mark is-returned">
        <circle cx={returned.x} cy={returned.y} r="11" />
      </g>
      <g class="kmap__mark is-current">
        <circle class="kmap__halo" cx={current.x} cy={current.y} r="24" />
        {[0, 1, 2].map((i) => <path class:list={["kmap__lesson", i < 2 && "is-done"]} d={lessonArc(i)} />)}
      </g>

      {named.map((n) => {
        const l = label(n);
        return (
          <text class:list={["kmap__label", `is-${n.state}`, n.label === "dim" && "is-aside"]} x={l.x} y={l.y} text-anchor={l.anchor}>
            {n.name}
          </text>
        );
      })}
    </svg>

    <div class="still__content knowledge" data-still-content>
      <p class="eyebrow"><span>06 / 10</span>Карта знаний</p>
      <h2 class="headline">Общая система одна.<br />Траектория — персональная.</h2>

      <dl class="route-passport">
        <div class="route-passport__route">
          <dt>Маршрут</dt>
          <dd>{pass.route}<small>{pass.programme}</small></dd>
        </div>
        <div>
          <dt>Старт</dt>
          <dd class="is-plain">{pass.start}</dd>
        </div>
        <div class="is-current" data-lit-line="focus">
          <dt>Текущий фокус</dt>
          <dd>{pass.focus.topic}<small>{pass.focus.meta}</small></dd>
        </div>
        <div class="is-returned" data-lit-line="returned">
          <dt>Возврат</dt>
          <dd>{pass.returned.topic}<small>{pass.returned.meta}</small></dd>
        </div>
        <div class="is-next" data-lit-line="next">
          <dt>Следующий шаг</dt>
          <dd>{pass.next.join(" → ")}</dd>
        </div>
      </dl>

      <div class="progress" data-progress>
        <p class="progress__strip" aria-hidden="true">
          {programmeStrip.map((m) => (
            <span title={m.module}>{m.states.map((s) => <i class={`is-${s}`} />)}</span>
          ))}
        </p>
        <p class="progress__count">
          <span class="is-done">{counts.done} из {total} освоено</span>
          <span class="is-current">{counts.current} изучается</span>
          <span class="is-returned">{counts.returned} нужно повторить</span>
        </p>
      </div>

      <p class="route-passport__note">
        Маршрут перестраивается по&nbsp;диагностике, домашним работам и&nbsp;повторяющимся ошибкам. Та&nbsp;же карта даёт
        другому ученику другую траекторию.
      </p>
      <p class="route-passport__source">Ученик демонстрационный; программа, темы и&nbsp;связи — из&nbsp;Hopes and Dreams.</p>
    </div>
  </div>
</section>
