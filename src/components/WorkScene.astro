---
import { quotes, controlRules, controlTrace } from "../data/content";
---

<!-- Scene 05: the assembly zone. Not a methodology diagram: what the system measures and how it answers. -->
<section class="track track--still" id="work" data-track="work" data-still data-scene-index="4">
  <div class="track__stage still" data-still-stage>
    <div class="still__shade still__shade--work" aria-hidden="true"></div>

    <div class="still__content work" data-still-content>
      <div class="work__text">
        <p class="eyebrow"><span>05 / 10</span>Сектор сборки · контур управления</p>
        <h2 class="visually-hidden">Как система реагирует на ученика</h2>
        <figure class="work__quote" lang="en">
          <blockquote>“{quotes.work.text}”</blockquote>
          <figcaption>— {quotes.work.author}</figcaption>
        </figure>
        <p class="work__lead">
          Результат строится итерациями: измерить состояние, выбрать следующий шаг, проверить
          и&nbsp;скорректировать маршрут.
        </p>

        <div class="rules">
          <p class="rules__title">Как система реагирует</p>
          <ul>
            {controlRules.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>

      <aside class="trace" aria-label="Пример одного маршрута" data-trace>
        <header class="trace__head">
          <p>Один маршрут <span>· пример</span></p>
          <p class="trace__legend">
            <span class="is-signal">замер</span>
            <span class="is-action">действие системы</span>
          </p>
        </header>
        <ol class="trace__steps">
          {controlTrace.map((s) => (
            <li class="trace__step" data-kind={s.kind} data-trace-step>
              <p class="trace__stage">{s.stage}</p>
              <p class="trace__text">{s.text}</p>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>
</section>
